<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Dialog id="markDialog" title="{ledger>/mark/title}" contentWidth="34rem" class="mrTheme sapUiContentPadding">
        <content>
            <VBox id="markContent">
                <Label id="markWhatLabel" text="{i18n>markWhatWeSee}" design="Bold" />
                <VBox id="markReasons" items="{ path: 'ledger>/mark/reasons', templateShareable: false }" class="sapUiTinyMarginTop sapUiSmallMarginBottom">
                    <HBox id="markReasonLine" alignItems="Start" class="sapUiTinyMarginBottom">
                        <core:Icon id="markReasonIcon" src="{ledger>icon}" class="sapUiTinyMarginEnd" />
                        <Text id="markReasonText" text="{ledger>explanation}" />
                    </HBox>
                </VBox>
                <Label id="markReasonLabel" text="{i18n>markReasonLabel}" labelFor="markReasonInput" required="true" />
                <TextArea id="markReasonInput" value="{ledger>/mark/reason}" placeholder="{i18n>markReasonPlaceholder}"
                    rows="4" width="100%" maxLength="1000" valueLiveUpdate="true" />
            </VBox>
        </content>
        <beginButton>
            <Button id="markSaveButton" text="{i18n>markSave}" type="Emphasized" icon="sap-icon://ti/flag-3"
                enabled="{= ${ledger>/mark/reason}.length > 0 }" press=".onSaveMark" />
        </beginButton>
        <endButton>
            <Button id="markCancelButton" text="{i18n>cancel}" press=".onCancelMark" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
