<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- Deepwood Forest: walk with your lantern to the torn page -->
    <Dialog id="mazeGame" title="{i18n>mazeTitle}" contentWidth="52rem" class="mrTheme sapUiContentPadding" draggable="false" resizable="false">
        <content>
            <VBox id="mazeContent">
                <Text id="mazeHowTo" text="{i18n>mazeHowTo}" class="huntSays sapUiSmallMarginBottom" />
                <core:HTML id="mazeBoard" content="{hunt>/maze/svg}" sanitizeContent="false" preferDOM="false" />
                <HBox id="mazeControls" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap" class="sapUiSmallMarginTop">
                    <HBox id="mazeArrows" alignItems="Center">
                        <Button id="mazeLeft" icon="sap-icon://ti/arrow-left" tooltip="{i18n>mazeLeft}" press=".onMazeLeft" class="fmArrow sapUiTinyMarginEnd" />
                        <VBox id="mazeUpDown">
                            <Button id="mazeUp" icon="sap-icon://ti/arrow-up" tooltip="{i18n>mazeUp}" press=".onMazeUp" class="fmArrow sapUiTinyMarginBottom" />
                            <Button id="mazeDown" icon="sap-icon://ti/arrow-down" tooltip="{i18n>mazeDown}" press=".onMazeDown" class="fmArrow" />
                        </VBox>
                        <Button id="mazeRight" icon="sap-icon://ti/arrow-right" tooltip="{i18n>mazeRight}" press=".onMazeRight" class="fmArrow sapUiTinyMarginBegin" />
                    </HBox>
                    <VBox id="mazeInfo" alignItems="End">
                        <ObjectStatus id="mazeSteps" text="{i18n>mazeSteps} {hunt>/maze/steps}" icon="sap-icon://ti/shoe" state="Information" />
                        <ObjectStatus id="mazeBump" text="{i18n>mazeBump}" icon="sap-icon://ti/tree" state="Warning" visible="{hunt>/maze/bump}" class="sapUiTinyMarginTop" />
                    </VBox>
                </HBox>
                <VBox id="mazeWin" visible="{hunt>/maze/solved}" class="sapUiSmallMarginTop">
                    <MessageStrip id="mazeWinStrip" text="{i18n>mazeWin}" type="Success" showIcon="true" class="sapUiTinyMarginBottom" />
                    <Text id="mazeNote" text="{i18n>mazeNote}" class="huntSays" />
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button id="mazeNew" text="{i18n>mazeNew}" icon="sap-icon://ti/refresh" press=".onNewMaze" />
            <Button id="mazeClose" text="{i18n>close}" type="Emphasized" press=".onCloseMaze" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
