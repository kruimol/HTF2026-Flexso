<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- All stamps: balloons, Tobin's pizza and a voucher for the fair -->
    <Dialog id="celebration" title="{i18n>prizeTitle}" contentWidth="44rem" class="mrTheme sapUiContentPadding" draggable="false" resizable="false">
        <content>
            <VBox id="prizeContent" alignItems="Center">
                <core:HTML id="prizeArt" content="{hunt>/prize/svg}" sanitizeContent="false" preferDOM="false" />
                <Text id="prizeText" text="{i18n>prizeText}" textAlign="Center" class="huntSays sapUiSmallMarginTop sapUiSmallMarginBottom" />
                <VBox id="prizeVoucher" alignItems="Center" class="ceVoucher">
                    <Title id="prizeVoucherTitle" text="{i18n>prizeVoucher}" level="H3" class="mrHeading" />
                    <Text id="prizeWhat" text="{i18n>prizeWhat}" class="ceWhat sapUiTinyMarginTop" />
                    <Label id="prizeCodeLabel" text="{i18n>prizeCodeLabel}" class="sapUiSmallMarginTop" />
                    <Text id="prizeCode" text="{hunt>/prize/code}" class="ceCode" />
                    <Text id="prizeHow" text="{i18n>prizeHow}" textAlign="Center" class="sapUiTinyMarginTop" />
                </VBox>
            </VBox>
        </content>
        <buttons>
            <Button id="prizeClose" text="{i18n>prizeClose}" icon="sap-icon://ti/confetti" type="Emphasized" press=".onClosePrize" />
        </buttons>
    </Dialog>
</core:FragmentDefinition>
